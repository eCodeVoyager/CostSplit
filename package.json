{
  "name": "costsplit",
  "version": "1.0.0",
  "description": "CostSplit - Shared Expense Manager (MERN Stack)",
  "scripts": {
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test": "npm run test:backend && npm run test:frontend",
    "build": "cd frontend && npm run build",
    "pm2:start": "cd backend && pm2 start server.js --name costsplit-backend",
    "pm2:stop": "pm2 stop costsplit-backend",
    "pm2:restart": "pm2 restart costsplit-backend",
    "pm2:delete": "pm2 delete costsplit-backend",
    "pm2:logs": "pm2 logs costsplit-backend",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status"
  },
  "keywords": [
    "expense",
    "splitter",
    "MERN",
    "react",
    "mongodb",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
