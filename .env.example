# CostSplit Environment Configuration
# Copy this file to .env and update with your values

# ===================================
# MongoDB Configuration (REQUIRED)
# ===================================
# External MongoDB connection string
# Examples:
# - Local MongoDB: mongodb://localhost:27017/costsplit
# - Docker host: mongodb://host.docker.internal:27017/costsplit
# - MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/costsplit
# - Remote: mongodb://username:password@remote-host:27017/costsplit
MONGODB_URI=mongodb://localhost:27017/costsplit

# ===================================
# JWT Configuration (REQUIRED)
# ===================================
# Secret key for JWT token generation (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration time (e.g., 7d, 30d, 1h)
JWT_EXPIRE=7d

# ===================================
# Server Configuration
# ===================================
# Backend API port
PORT=5000

# Node environment (development, production)
NODE_ENV=production

# ===================================
# CORS Configuration
# ===================================
# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:3000

# ===================================
# Frontend Configuration
# ===================================
# Backend API URL for frontend
VITE_API_URL=http://localhost:5000/api

# ===================================
# Docker-Specific Configuration
# ===================================
# If using Docker and connecting to MongoDB on host machine, use:
# MONGODB_URI=mongodb://host.docker.internal:27017/costsplit

# If using Docker and frontend needs to connect to backend, use:
# VITE_API_URL=http://backend:5000/api (for internal Docker network)
# or
# VITE_API_URL=http://localhost:5000/api (for external access)
