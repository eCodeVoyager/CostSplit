{
  "name": "costsplit-v2",
  "private": true,
  "version": "2.2.0",
  "minAppVersion": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.mjs",
    "build": "tsc -b && vite build",
    "start": "npm run build && npm run server",
    "preview": "vite preview",
    "test": "vitest run && node --test server/server.test.mjs",
    "e2e": "vite build --mode e2e --outDir dist-e2e && playwright test",
    "icons": "pwa-assets-generator",
    "build:android": "tsc -b && vite build --mode android --outDir dist-android && cap sync android",
    "apk": "npm run build:android && node scripts/gradle.mjs assembleDebug",
    "phone": "adb reverse tcp:8787 tcp:8787 && adb install -r android/app/build/outputs/apk/debug/app-debug.apk && adb shell monkey -p app.costsplit -c android.intent.category.LAUNCHER 1",
    "release": "node scripts/release.mjs",
    "deploy:s3": "node scripts/deploy-s3.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3",
    "vaul": "^1.1.2",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
