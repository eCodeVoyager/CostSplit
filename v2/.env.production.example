# Copy to .env.production for `npm run release` (web build).
# Where the sync server runs (server/server.mjs behind https). Leave empty only
# if the same server also hosts this web app.
VITE_SERVER_URL=https://api.costsplit.example.com
# Where this web app and /download are hosted (S3 + CloudFront, or the server).
VITE_PUBLIC_URL=https://costsplit.example.com
